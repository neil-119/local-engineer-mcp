{
  "name": "local-engineer-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "container",
    "assets",
    "README.md",
    "config.example.yaml"
  ],
  "bin": {
    "local-engineer": "dist/index.js",
    "local-engineer-mcp": "dist/index.js"
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "doctor": "node dist/index.js doctor",
    "prepack": "pnpm build",
    "test": "vitest run --pool=threads --no-file-parallelism",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "check": "pnpm lint && pnpm build && pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "yaml": "^2.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.1.1"
  }
}
